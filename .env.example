# Job Application Automation Environment Template
# Copy this file to .env and fill in your actual values.

# General application settings
APP_NAME=job-automation
APP_ENV=development
LOG_LEVEL=INFO

# LinkedIn credentials
LINKEDIN_EMAIL=your_linkedin_email@example.com
LINKEDIN_PASSWORD=your_linkedin_password
LINKEDIN_USERNAME=your_linkedin_username

# Naukri credentials
NAUKRI_EMAIL=your_naukri_email@example.com
NAUKRI_PASSWORD=your_naukri_password
NAUKRI_USERNAME=your_naukri_username

# Profile configuration
USER_FULL_NAME=Your Full Name
USER_PHONE=+91XXXXXXXXXX
USER_LOCATION=Your City
PREFERRED_LOCATIONS=Remote,Hyderabad,Bangalore
JOB_TITLES=Software Engineer,Data Analyst
SKILLS=Python,SQL,Machine Learning,API Integration
EXPERIENCE_YEARS=3
NOTICE_PERIOD=30
EXPECTED_SALARY=12LPA

# Resume and documents
RESUME_PATH=./data/resumes/resume.pdf
COVER_LETTER_PATH=./data/cover_letters/cover_letter.pdf

# Automation controls
AUTOMATION_ENABLED=false
JOB_CHECK_INTERVAL_MINUTES=30
MAX_APPLICATIONS_PER_DAY=10
APPROVAL_REQUIRED=true
MATCH_SCORE_THRESHOLD=70

# Security and storage
SECRET_KEY=replace_with_a_secure_random_key
DATABASE_URL=sqlite:///data/app.db

# Optional notification settings
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your_email@example.com
SMTP_PASSWORD=your_email_password
EMAIL_TO=alerts@example.com
